<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    tools:context=".MainActivity">

    <!-- ══════════════════════════════════════ -->
    <!--          SCROLLABLE CONTENT           -->
    <!-- ══════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Hero title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_hero_title"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary"
                android:textAlignment="center"
                android:lineSpacingExtra="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="12dp" />

            <!-- Hero subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_hero_subtitle"
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:textAlignment="center"
                android:lineSpacingExtra="4dp"
                android:paddingBottom="28dp" />

            <!-- ──────────────────────────────── -->
            <!--        REGISTER CARD            -->
            <!-- ──────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_register"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp"
                    android:gravity="center">

                    <!-- Icon circle -->
                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_icon_circle_blue"
                        android:layout_marginBottom="18dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_person_add"
                            android:layout_gravity="center"
                            android:contentDescription="Register icon" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/register_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:paddingBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/register_desc"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_secondary"
                        android:textAlignment="center"
                        android:lineSpacingExtra="4dp"
                        android:paddingBottom="22dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_register"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="@string/register_btn"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/color_primary"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ──────────────────────────────── -->
            <!--         LOGIN CARD              -->
            <!-- ──────────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="28dp"
                    android:gravity="center">

                    <!-- Icon circle -->
                    <FrameLayout
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@drawable/bg_icon_circle_gray"
                        android:layout_marginBottom="18dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_login_arrow"
                            android:layout_gravity="center"
                            android:contentDescription="Login icon" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_card_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary"
                        android:paddingBottom="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/login_card_desc"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_secondary"
                        android:textAlignment="center"
                        android:lineSpacingExtra="4dp"
                        android:paddingBottom="22dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_login"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="@string/login_card_btn"
                        android:textSize="16sp"
                        android:textColor="@color/color_primary"
                        app:strokeColor="@color/color_primary"
                        app:strokeWidth="2dp"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
