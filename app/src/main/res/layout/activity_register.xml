<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    tools:context=".activities.RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:orientation="horizontal"
        android:background="@color/color_background"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_logo_techserve"
            android:contentDescription="@string/content_desc_logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:background="@color/color_primary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="28dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="@string/register_text"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="28dp"
                            android:text="@string/login_subtitle"
                            android:textSize="15sp"
                            android:textColor="@color/color_text_secondary"
                            android:lineSpacingExtra="4dp" />

                        <!-- Username -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="@string/username_text"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_secondary"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginBottom="20dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_username" />

                            <EditText
                                android:id="@+id/et_username"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:hint="@string/username_text"
                                android:textSize="15sp"
                                android:textColor="@color/color_text_primary"
                                android:textColorHint="@color/color_bottom_nav_inactive"
                                android:background="@null"
                                android:inputType="text"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- Nombre -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="@string/register_label_nombre"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_secondary"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginBottom="20dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_person" />

                            <EditText
                                android:id="@+id/et_nombre"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:hint="@string/hint_nombre"
                                android:textSize="15sp"
                                android:textColor="@color/color_text_primary"
                                android:textColorHint="@color/color_bottom_nav_inactive"
                                android:background="@null"
                                android:inputType="textPersonName|textCapWords"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- Primer apellido -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="@string/register_label_apellido1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_secondary"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginBottom="20dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_person" />

                            <EditText
                                android:id="@+id/et_apellido1"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:hint="@string/hint_apellido1"
                                android:textSize="15sp"
                                android:textColor="@color/color_text_primary"
                                android:textColorHint="@color/color_bottom_nav_inactive"
                                android:background="@null"
                                android:inputType="textPersonName|textCapWords"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- Segundo apellido (opcional) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="@string/register_label_apellido2"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_secondary"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginBottom="20dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_person" />

                            <EditText
                                android:id="@+id/et_apellido2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:hint="@string/hint_apellido2"
                                android:textSize="15sp"
                                android:textColor="@color/color_text_primary"
                                android:textColorHint="@color/color_bottom_nav_inactive"
                                android:background="@null"
                                android:inputType="textPersonName|textCapWords"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- Teléfono -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="@string/register_label_telefono"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_secondary"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginBottom="20dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_phone" />

                            <EditText
                                android:id="@+id/et_telefono"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:hint="@string/hint_telefono"
                                android:textSize="15sp"
                                android:textColor="@color/color_text_primary"
                                android:textColorHint="@color/color_bottom_nav_inactive"
                                android:background="@null"
                                android:inputType="phone"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- Email -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:text="@string/register_label_email"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_secondary"
                            android:letterSpacing="0.08" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginBottom="20dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_email" />

                            <EditText
                                android:id="@+id/et_email"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:hint="@string/login_email_hint"
                                android:textSize="15sp"
                                android:textColor="@color/color_text_primary"
                                android:textColorHint="@color/color_bottom_nav_inactive"
                                android:background="@null"
                                android:inputType="textEmailAddress"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- Contraseña -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/login_password_label"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/color_text_secondary"
                                android:letterSpacing="0.08" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginBottom="16dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_input_field"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_lock" />

                            <EditText
                                android:id="@+id/et_password"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:paddingStart="12dp"
                                android:hint="@string/hint_password_stars"
                                android:textSize="15sp"
                                android:textColor="@color/color_text_primary"
                                android:textColorHint="@color/color_bottom_nav_inactive"
                                android:background="@null"
                                android:inputType="textPassword"
                                android:singleLine="true" />
                        </LinearLayout>

                        <!-- Botón Registrarse -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_register"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginBottom="24dp"
                            style="@style/Widget.Material3.Button"
                            android:text="@string/register_btn"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/color_primary"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_login_arrow"
                            app:iconGravity="end"
                            app:iconTint="@color/white" />



                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>